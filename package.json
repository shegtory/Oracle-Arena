{
  "name": "oracle-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "cycle": "tsx bot/run-cycle.ts",
    "typecheck": "tsc -p bot/tsconfig.json",
    "build": "npm run typecheck && npm run build --workspace oracle-arena-dashboard",
    "build:frontend": "npm run build --workspace oracle-arena-dashboard"
  },
  "dependencies": {
    "@somnia-chain/markets-sdk": "^0.28.1",
    "dotenv": "^16.4.5",
    "viem": "^2.37.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
