# Wallet used to submit Somnia testnet transactions. Never commit a real key.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
NETWORK=testnet

# Optional network overrides
# CHAIN_ID=50312
# RPC_URL=https://api.infra.testnet.somnia.network
# WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
# INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# Trading policy
MAX_TRADE_TUSDC=5
MIN_TIME_LEFT_SECONDS=15
MIN_LIQUIDITY_SHARES=50
ASK_PREMIUM=0.01
TREND_SAMPLE_DELAY_MS=120000
PRICE_SOURCE_TIMEOUT_MS=60000

# Keep enabled until you are ready to submit live testnet orders.
DRY_RUN=true

# Telemetry publishing is authenticated automatically in GitHub Actions.
# GITHUB_TOKEN=github_actions_token
